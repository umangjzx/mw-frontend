# ══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT ENVIRONMENT VARIABLES
# Copy this file and fill in real values for your deployment environment.
# ══════════════════════════════════════════════════════════════════════════════

# ── SHARED SECRET (must match between MW Backend & Detection Service) ─────────
SAFETY_API_KEY=generate-a-strong-random-string-here

# ── MW BACKEND (.env for melody-wings-backend) ────────────────────────────────
# These go in melody-wings-backend/.env

ENVIRONMENT=production
# Valid values: dev | development | staging | production
# - dev/development: enables localhost CORS, disables webhook signature requirement
# - staging: enables localhost CORS, enforces webhook signatures
# - production (default): strict CORS, strict webhook verification
DB_NAME=melody_wings
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_USERNAME=your-mongo-user
MONGO_PASSWORD=your-mongo-password

JWT_SECRET=generate-a-32-char-secret
JWT_EXPIRES_IN=60
ACCESS_TOKEN_EXPIRES_IN_DAYS=7
JWT_ALGORITHM=HS256

ENCRYPTION_KEY=generate-a-fernet-key

# Safety integration (internal Docker network URL)
SAFETY_SERVICE_URL=http://safety-backend:8000
SAFETY_API_KEY=same-as-above
SAFETY_WEBHOOK_SECRET=another-random-secret


# ── DETECTION PIPELINE (.env for New-Rmsi-Latest/backend) ─────────────────────
# These go in New-Rmsi-Latest/backend/.env

ENV=production
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/audio_safety_db?retryWrites=true&w=majority
MONGO_DB_NAME=audio_safety_db

JWT_SECRET=a-different-32-char-secret-for-safety
JWT_EXPIRE_MINUTES=480

API_KEY=same-safety-api-key-as-above

# S3 for audio/PDF storage
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=ap-south-1
S3_BUCKET_NAME=audio-safety-storage

# Email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@melodywings.org
SMTP_PASSWORD=app-password-here
ALERT_RECIPIENTS=admin@melodywings.org

# ML settings
ENABLE_ML_CLASSIFIER=true
ENABLE_LLM_SUMMARY=false
USE_CELERY=true

# MW Backend webhook callback (internal Docker network)
MW_BACKEND_URL=http://mw-backend:8080
MW_CALLBACK_SECRET=same-webhook-secret-as-above

# CORS (add your production admin panel URL)
ALLOWED_ORIGINS=https://admin.melodywings.org,https://safety.melodywings.org

# Redis (Docker internal)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
